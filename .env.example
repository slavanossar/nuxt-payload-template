# Nuxt Site Environment [development | staging | production]
NUXT_SITE_ENV=development
# Nuxt's Nitro server host
NITRO_HOST=0.0.0.0
# Nuxt's Nitro server port
NITRO_PORT=3000

# Site name
SITE_NAME=Nuxt x Payload
# Site URL
NEXT_PUBLIC_SITE_URL=
# Payload's NextJS server port
PORT=3001
# Route for Payload API
NEXT_PUBLIC_PAYLOAD_API_ROUTE=/payload-api

# MongoDB database URL
DATABASE_MONGODB_URI=
# MongoDB database name
DATABASE_NAME=nuxt-payload
# Payload secret key
PAYLOAD_SECRET=
# Email for the first Staff user
SEED_STAFF_EMAIL=
# Password for the first Staff user
SEED_STAFF_PASSWORD=

# Vercel Blob Store ID
BLOB_STORE_ID=
# Vercel Blob Read Write Token
BLOB_READ_WRITE_TOKEN=

# Mux Token ID
MUX_TOKEN_ID=
# Mux Token Secret
MUX_TOKEN_SECRET=
# Mux Webhook Secret
MUX_WEBHOOK_SECRET=
