{
  "$schema": "https://v2-11-9.turborepo.dev/schema.json",
  "globalDependencies": [],
  "globalEnv": [
    "SITE_NAME",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_PAYLOAD_API_ROUTE",
    "PORT"
  ],
  "globalPassThroughEnv": ["NODE_USE_SYSTEM_CA"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "nuxt#dev": {
      "env": ["NITRO_HOST", "NITRO_PORT", "NUXT_SITE_ENV"],
      "passThroughEnv": ["NUXT_PAYLOADCMS_URL"]
    },
    "payloadcms#dev": {
      "passThroughEnv": [
        "DATABASE_MONGODB_URI",
        "DATABASE_NAME",
        "PAYLOAD_SECRET",
        "SEED_STAFF_EMAIL",
        "SEED_STAFF_PASSWORD",
        "BLOB_*",
        "MUX_*"
      ]
    },
    "build": {
      "dependsOn": ["^build"]
    },
    "nuxt#build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**"],
      "env": ["NITRO_HOST", "NITRO_PORT", "NUXT_SITE_ENV"],
      "passThroughEnv": ["NUXT_PAYLOADCMS_URL"]
    },
    "payloadcms#build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"],
      "passThroughEnv": [
        "DATABASE_MONGODB_URI",
        "DATABASE_NAME",
        "PAYLOAD_SECRET",
        "SEED_STAFF_EMAIL",
        "SEED_STAFF_PASSWORD",
        "BLOB_*",
        "MUX_*"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "nuxt#start": {
      "env": ["NITRO_HOST", "NITRO_PORT", "NUXT_SITE_ENV"],
      "passThroughEnv": ["NUXT_PAYLOADCMS_URL"]
    },
    "payloadcms#start": {
      "passThroughEnv": [
        "DATABASE_MONGODB_URI",
        "DATABASE_NAME",
        "PAYLOAD_SECRET",
        "SEED_STAFF_EMAIL",
        "SEED_STAFF_PASSWORD",
        "BLOB_*",
        "MUX_*"
      ]
    },
    "generate": {
      "cache": false
    },
    "payloadcms#generate": {
      "outputs": ["payload-types.d.ts", "schema.graphql"],
      "passThroughEnv": [
        "DATABASE_MONGODB_URI",
        "DATABASE_NAME",
        "PAYLOAD_SECRET",
        "SEED_STAFF_EMAIL",
        "SEED_STAFF_PASSWORD",
        "BLOB_*",
        "MUX_*"
      ]
    },
    "nuxt#generate": {
      "dependsOn": ["payloadcms#generate"],
      "outputs": ["graphql/exports.ts", "graphql/introspection.json"]
    },
    "regenerate-image-sizes": {
      "cache": false
    },
    "seed": {
      "cache": false
    },
    "payloadcms#seed": {
      "passThroughEnv": [
        "DATABASE_MONGODB_URI",
        "DATABASE_NAME",
        "PAYLOAD_SECRET",
        "SEED_STAFF_EMAIL",
        "SEED_STAFF_PASSWORD",
        "BLOB_*",
        "MUX_*"
      ]
    },
    "payloadcms#regenerate-image-sizes": {
      "passThroughEnv": [
        "DATABASE_MONGODB_URI",
        "DATABASE_NAME",
        "PAYLOAD_SECRET",
        "SEED_STAFF_EMAIL",
        "SEED_STAFF_PASSWORD",
        "BLOB_*",
        "MUX_*"
      ]
    },
    "lint": {},
    "format": {}
  }
}
