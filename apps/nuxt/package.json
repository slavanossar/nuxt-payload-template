{
  "name": "nuxt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev --no-tui",
    "build": "nuxi build",
    "start": "node .output/server/index.mjs",
    "lint": "eslint --ext .js,.ts,.vue .",
    "generate": "pnpm run generate:schema && pnpm run generate:types",
    "generate:schema": "node ./graphql/schemaQuery.mjs",
    "generate:types": "graphql-codegen -r dotenv/config --config codegen.ts && mv graphql/exports.d.ts graphql/index.js"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --fix",
    "*": "prettier -w -u"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript-vue-apollo": "^5.0.1",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint-plugin-nuxt": "^4.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "dependencies": {
    "@nuxtjs/apollo": "5.0.0-alpha.16",
    "@nuxtjs/seo": "^6.0.1",
    "@payloadcms/live-preview": "^3.91.0",
    "@pinia/nuxt": "1.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "detect-it": "^4.0.1",
    "dotenv": "^18.0.8",
    "motion-v": "^2.8.0",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "slate": "^0.146.0",
    "tailwindcss": "^4.3.3"
  }
}
