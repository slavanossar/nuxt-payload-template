# Nuxt Site Environment [development | staging | production]
NUXT_SITE_ENV=development
# Nuxt's Nitro server host
NITRO_HOST=0.0.0.0
# Nuxt's Nitro server port
NITRO_PORT=3000

# Site name
SITE_NAME=Nuxt x Payload
# Site URL
NEXT_PUBLIC_SITE_URL=
# Payload's NextJS server port
PORT=3001
# Route for Payload API
NEXT_PUBLIC_PAYLOAD_API_ROUTE=/payload-api

# MongoDB database name
DATABASE_NAME=nuxt-payload
# Payload secret key
PAYLOAD_SECRET=

# Cloudflare R2 Endpoint
R2_ENDPOINT=
# Cloudflare R2 Region
R2_REGION="auto"
# Cloudflare R2 Bucket
R2_BUCKET=
# Cloudflare R2 Access Key ID
R2_ACCESS_KEY_ID=
# Cloudflare R2 Secret Access Key
R2_SECRET_ACCESS_KEY=
# Cloudflare R2 Custom Domain
R2_CUSTOM_DOMAIN=
