{
  "name": "payloadcms",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate": "cross-env NODE_OPTIONS=--no-deprecation pnpm run generate:importmap && cross-env NODE_OPTIONS=--no-deprecation pnpm run generate:types && cross-env NODE_OPTIONS=--no-deprecation pnpm run generate:schema",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:schema": "cross-env NODE_OPTIONS=--no-deprecation payload-graphql generate:schema",
    "regenerate-image-sizes": "cross-env payload run scripts/regenerate-image-sizes.ts",
    "seed": "cross-env payload run scripts/seed.ts",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "dotenv -e ../../.env -- cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-config-next": "^16.4.3",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "^3.92.1",
    "@payloadcms/next": "^3.92.1",
    "@payloadcms/plugin-seo": "^3.92.1",
    "@payloadcms/richtext-lexical": "^3.92.1",
    "@payloadcms/storage-vercel-blob": "^3.92.1",
    "@pro-laico/payload-mux": "^0.8.5",
    "cross-env": "^10.1.0",
    "next": "^16.4.3",
    "node-html-parser": "^9.0.6",
    "payload": "^3.92.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "slugify": "^1.6.9"
  }
}
